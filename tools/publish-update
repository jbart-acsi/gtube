#!/usr/bin/env -S uv run --no-project --with cryptography python3
"""Publishes the current commit for Windows, for test copies of gtube to fetch within a minute.

    tools/publish-update             build the current commit for Windows and publish it
    tools/publish-update --to PLACE  publish to PLACE instead

The build is release/stage.sh's Windows archive, named after the commit's short hash (-Dbuild),
which is what makes a copy look for updates; release builds have no name and never do. PLACE is
HOST:FOLDER (by default hetzner:/srv/gtube-updates, served at the address in src/main.c) or a local
folder. It gets files/SHA256 for gtube.exe and gtube.exe.gpu, a manifest naming the build and each
file's name, hash and size, the manifest's signature (manifest.txt.sig) with the key in
~/.config/gtube/update-signing.key, and the archive as gtube-windows.zip for a first install. The
files go up before the manifest, which goes up whole, so a copy never reads one that names a file
not yet there. The tree must be clean, since the build is named after the commit.
"""

import argparse
import hashlib
import os
import shutil
import subprocess
import sys
import tempfile
import zipfile

from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
FILES = ["gtube.exe", "gtube.exe.gpu"]
KEY = os.path.expanduser("~/.config/gtube/update-signing.key")
ZIP = "gtube-windows.zip"


def run(*command, **kw):
    subprocess.run(command, check=True, **kw)


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--to", default="hetzner:/srv/gtube-updates")
    args = parser.parse_args()
    if subprocess.run(["git", "-C", ROOT, "status", "--porcelain", "--untracked-files=no"], capture_output=True, text=True).stdout.strip():
        sys.exit("the tree has changes that are not committed: a build is published from a commit")
    build = subprocess.run(["git", "-C", ROOT, "rev-parse", "--short", "HEAD"], check=True, capture_output=True, text=True).stdout.strip()
    with open(KEY, "rb") as f:
        key = Ed25519PrivateKey.from_private_bytes(f.read())
    with tempfile.TemporaryDirectory() as out:
        staged = subprocess.run([os.path.join(ROOT, "release", "stage.sh"), "windows", os.path.join(out, "stage")], check=True,
                                capture_output=True, text=True, env={**os.environ, "GTUBE_BUILD": build}).stdout.strip().splitlines()[-1]
        shutil.move(staged, os.path.join(out, ZIP))
        os.makedirs(os.path.join(out, "files"))
        lines = [f"build {build}"]
        with zipfile.ZipFile(os.path.join(out, ZIP)) as z:
            for name in FILES:
                data = next(z.read(i) for i in z.namelist() if i.split("/")[-1] == name)
                digest = hashlib.sha256(data).hexdigest()
                with open(os.path.join(out, "files", digest), "wb") as f:
                    f.write(data)
                lines.append(f"file {name} {digest} {len(data)}")
        manifest = "\n".join(lines) + "\n"
        with open(os.path.join(out, "manifest.txt"), "w") as f:
            f.write(manifest)
        with open(os.path.join(out, "manifest.txt.sig"), "w") as f:
            f.write(key.sign(manifest.encode()).hex() + "\n")
        if ":" in args.to:
            host, place = args.to.split(":", 1)
            run("ssh", "-o", "BatchMode=yes", host, f"mkdir -p {place}/files {place}/next")
            run("scp", "-q", *[os.path.join(out, "files", d) for d in os.listdir(os.path.join(out, "files"))], f"{host}:{place}/files/")
            run("scp", "-q", os.path.join(out, "manifest.txt"), os.path.join(out, "manifest.txt.sig"), os.path.join(out, ZIP), f"{host}:{place}/next/")
            # (the signature first, then the manifest it signs: one read between the two sees a
            # mismatch and is tried again a minute later)
            run("ssh", "-o", "BatchMode=yes", host, f"cd {place} && mv next/{ZIP} . && mv next/manifest.txt.sig . && mv next/manifest.txt . && chmod -R a+rX {place}")
        else:
            os.makedirs(os.path.join(args.to, "files"), exist_ok=True)
            for d in os.listdir(os.path.join(out, "files")):
                shutil.copyfile(os.path.join(out, "files", d), os.path.join(args.to, "files", d))
            for name in (ZIP, "manifest.txt.sig", "manifest.txt"):
                shutil.copyfile(os.path.join(out, name), os.path.join(args.to, name + ".part"))
                os.replace(os.path.join(args.to, name + ".part"), os.path.join(args.to, name))
    print(f"published build {build} to {args.to}")


if __name__ == "__main__":
    main()
